{
  "suite_id": "kimi-k3",
  "suite_version": "1.0.0",
  "source_doc": "docs/Kimi-K3供应商接入自测指导.pdf",
  "design_doc": "docs/模型自测台设计方案.md",
  "design_doc_version": "v0.3",
  "description": "Kimi-K3 供应商接入自测指导对应的可执行套件定义：22 项基础用例 + 1 项 reasoning_effort 附加用例。作为默认测试套件种子数据，新供应商可克隆本文件后按 CAPABILITY_PROFILE 差异增删（07节 SOP）。",
  "protocol": {
    "base_path": "/v1/chat/completions",
    "auth_header": "Authorization: Bearer {{api_key}}",
    "content_type": "application/json"
  },
  "defaults": {
    "timeout_seconds": 30,
    "category_timeout_overrides": {
      "多模态图像": 90,
      "多模态视频": 90,
      "reasoning_effort": 180
    }
  },
  "fixtures": {
    "tools": {
      "get_weather": {
        "type": "function",
        "function": {
          "name": "get_weather",
          "description": "查询指定城市的当前天气",
          "parameters": {
            "type": "object",
            "properties": { "city": { "type": "string" } },
            "required": ["city"]
          }
        }
      }
    },
    "prompts": {
      "generic_short": "请用中文写一句关于春天的话。",
      "weather_query": "北京今天天气怎么样？",
      "reasoning_prompt": "请计算 37 乘以 48 等于多少，并简要给出计算过程。",
      "reasoning_effort_prompt": "用 1、2、3、4、5 这五个数字各恰好使用一次，组成一个能被 11 整除的五位数，给出这个五位数。",
      "structured_weather_question": "请用结构化数据回答一个用于测试的虚构天气示例：城市名 city 填“测试城市”，摄氏温度 temperature_c 填 21.5，这两个值是本次测试固定要求的取值，不代表真实天气，不需要查证真实数据。"
    }
  },
  "materials_manifest": "suites/kimi-k3/materials/manifest.json",
  "cases": [
    {
      "id": "protocol.stream_integrity",
      "category": "协议完整性",
      "name": "Stream 完整性",
      "required_rule": "fixed_required",
      "counts_in_base22": true,
      "capability_tag": null,
      "assertion_type": "stream_integrity",
      "repeat_attempts": 1,
      "pdf_ref": "2.2 样例请求（Stream 完整性）",
      "request_template": {
        "method": "POST",
        "body": {
          "model": "{{model_key}}",
          "messages": [{ "role": "user", "content": "{{prompts.generic_short}}" }],
          "stream": true
        }
      }
    },
    {
      "id": "protocol.usage_nonstream",
      "category": "协议完整性",
      "name": "Usage 字段 · 非流式",
      "required_rule": "fixed_required",
      "counts_in_base22": true,
      "capability_tag": null,
      "assertion_type": "usage_fields_nonstream",
      "repeat_attempts": 1,
      "pdf_ref": "2.2",
      "request_template": {
        "method": "POST",
        "body": {
          "model": "{{model_key}}",
          "messages": [{ "role": "user", "content": "{{prompts.generic_short}}" }],
          "stream": false
        }
      }
    },
    {
      "id": "protocol.usage_stream",
      "category": "协议完整性",
      "name": "Usage 字段 · 流式",
      "required_rule": "fixed_required",
      "counts_in_base22": true,
      "capability_tag": null,
      "assertion_type": "usage_fields_stream",
      "repeat_attempts": 1,
      "pdf_ref": "2.2",
      "notes": "两段式尝试：任一变体末包（[DONE] 前最后一包）自带合法 usage 即通过（04节修订，避免强制要求 stream_options.include_usage 生效）",
      "request_template": {
        "method": "POST",
        "body": {
          "model": "{{model_key}}",
          "messages": [{ "role": "user", "content": "{{prompts.generic_short}}" }],
          "stream": true
        }
      },
      "variants": [
        { "variant_label": "no_include_usage", "request_overrides": {} },
        { "variant_label": "with_include_usage", "request_overrides": { "stream_options": { "include_usage": true } } }
      ]
    },
    {
      "id": "multimodal.image_url",
      "category": "多模态图像",
      "name": "Image_url",
      "required_rule": "declared_required",
      "counts_in_base22": true,
      "capability_tag": "image_url",
      "assertion_type": "deterministic_multimodal_qa",
      "repeat_attempts": 1,
      "pdf_ref": "2.3",
      "material_ref": { "material_id": "image_qa_v1", "form": "url" },
      "request_template": {
        "method": "POST",
        "body": {
          "model": "{{model_key}}",
          "messages": [
            {
              "role": "user",
              "content": [
                { "type": "text", "text": "{{material:image_qa_v1:question_prompt}}" },
                { "type": "image_url", "image_url": { "url": "{{material:image_qa_v1:url}}" } }
              ]
            }
          ],
          "stream": false
        }
      }
    },
