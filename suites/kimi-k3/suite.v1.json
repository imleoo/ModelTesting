      "repeat_attempts": 1,
      "pdf_ref": "2.4",
      "notes": "与 tool.choice_required 共用 tool_choice:required 触发方式，两者均必过；本用例代表 PDF 总览表『工具调用支持 1 项』的独立计数项，与『工具调用检测』的 6 项分别计数（合计 7 项工具相关用例）。",
      "request_template": {
        "method": "POST",
        "body": {
          "model": "{{model_key}}",
          "messages": [{ "role": "user", "content": "{{prompts.weather_query}}" }],
