{
  "suite_id": "kimi-k3",
  "suite_version": "1.2.0",
  "design_doc": "docs/模型自测台设计方案.md",
  "design_doc_version": "v0.3",
  "description": "Kimi-K3 套件的可执行套件定义：25 项基础用例 + 2 项附加用例（reasoning_effort、长上下文）+ 6 项『输入校验』附加用例 + 1 项『上下文缓存』附加用例。v1.1.0 新增 5 项输入校验用例，来自真实测试中发现的网关输入校验缺口。v1.2.0 从 z-ai 套件（suites/z-ai/suite.v1.json）补齐 7 项协议/能力基线用例（output_control.max_tokens_truncation、output_control.stop_semantics、determinism.temperature_zero、thinking.reasoning_effort_off、context.long_context_recall、cache.prompt_cache_hit_rate、input_validation.max_tokens_over_limit），使两套件覆盖对齐，差异只保留在各自模型的真实能力边界（多模态、tool_choice_function 等）。作为默认测试套件种子数据，新供应商可克隆本文件后按 CAPABILITY_PROFILE 差异增删。",
  "protocol": {
    "base_path": "/v1/chat/completions",
    "auth_header": "Authorization: Bearer {{api_key}}",
    "content_type": "application/json"
  },
  "defaults": {
    "timeout_seconds": 30,
    "category_timeout_overrides": {
      "多模态图像": 90,
      "多模态视频": 90,
      "reasoning_effort": 180,
      "输出控制": 120,
      "确定性": 120,
      "长上下文": 900,
      "上下文缓存": 300
    }
  },
  "fixtures": {
    "tools": {
      "get_weather": {
        "type": "function",
        "function": {
          "name": "get_weather",
          "description": "查询指定城市的当前天气",
          "parameters": {
            "type": "object",
            "properties": { "city": { "type": "string" } },
            "required": ["city"]
          }
        }
      }
    },
    "prompts": {
      "generic_short": "请用中文写一句关于春天的话。",
      "weather_query": "北京今天天气怎么样？",
      "reasoning_prompt": "请计算 37 乘以 48 等于多少，并简要给出计算过程。",
      "reasoning_effort_prompt": "用 1、2、3、4、5 这五个数字各恰好使用一次，组成一个能被 11 整除的五位数，给出这个五位数。",
      "structured_weather_question": "请用结构化数据回答一个用于测试的虚构天气示例：城市名 city 填“测试城市”，摄氏温度 temperature_c 填 21.5，这两个值是本次测试固定要求的取值，不代表真实天气，不需要查证真实数据。",
      "long_output_prompt": "请写一篇不少于 2000 字的散文，题目是《四季》，直接开始正文，不要写标题也不要写提纲。",
      "stop_sequence_prompt": "请严格按下面的格式输出三行，每行一个单词，不要加任何解释、编号或标点：\nALPHA\nBRAVO\nCHARLIE",
      "determinism_prompt": "请用中文写一段 80 字左右的说明，介绍什么是哈希函数。直接输出正文。",
      "cache_probe_question": "请只回答两个字：收到。",
      "long_context_question": "上文中【暗号】后面的那个四位数字是多少？只输出这四位数字，不要输出任何其他字符。"
    }
  },
  "materials_manifest": "suites/kimi-k3/materials/manifest.json",
  "cases": [
